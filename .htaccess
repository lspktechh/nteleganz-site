# PHP Limits and Hardening
php_value upload_max_filesize 24M
php_value post_max_size 24M
php_value max_execution_time 120
php_value max_input_time 120
php_value memory_limit 256M
php_flag session.upload_progress.enabled Off

# Disable mod_security for upload endpoint (prevents 406)
<IfModule mod_security.c>
    SecRuleEngine Off
    SecRequestBodyAccess Off
</IfModule>

# Security headers & anti-fingerprinting
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Cache static assets
# Observação: a Hostinger (LiteSpeed) aplica um max-age padrão de 7 dias aos
# assets. O ExpiresByType do .htaccess é ignorado; o que funciona é forçar o
# cabeçalho com mod_headers. Com estes valores, deploy vira "sobe e pronto":
# - HTML: sempre recarregar
# - JS/CSS/JSON: revalidado em TODO acesso via 304 (inalterado) / 200
#   (alterado). Subiu arquivo novo na Hostinger -> o cliente já pega na hora,
#   sem limpar cache do navegador e sem precisar trocar o "?v=" à mão.
# - Imagens: cache longo (não mudam com frequência)
<IfModule mod_headers.c>
    # HTML — nunca cachear (pega upload novo sozinho)
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    # JS/CSS/JSON — SITE SE ATUALIZA SOZINHO: "no-cache" faz o navegador
    # SEMPRE perguntar ao servidor antes de usar o arquivo. Subiu arquivo
    # novo na Hostinger -> o próximo acesso já baixa a versão nova (200),
    # senão recebe 304 (inalterado). Não precisa de ?v=, script ou limpar
    # cache. O "?v=" existente continua válido, mas vira opcional.
    <FilesMatch "\.(js|css|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Imagens — cache longo no navegador
    <FilesMatch "\.(webp|png|jpe?g|svg|avif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Fallback caso mod_headers esteja indisponível (mantém algo razoável)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/x-javascript "access plus 0 seconds"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Block sensitive files. robots.txt, sitemap.php and google*.html MUST stay
# public (they are required for SEO/Google Search Console) and are NOT listed here.
<FilesMatch "^(\.env(\.\w+)?|\.htaccess|\.gitignore|\.user\.ini|\.gitconfig|phpinfo\.php|\.env\.local)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Disable directory listing
# Prioridade de execução: PHP antes de HTML estático
DirectoryIndex index.php index.html index.htm

# Catálogo e backups (data/) só podem ser lidos pela API. Sem este bloqueio,
# qualquer pessoa baixaria products.json e veria/editaria o catálogo inteiro
# por URL. RewriteRule é necessário porque <FilesMatch> só casa basename.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git(/|$) - [F,L]
    RewriteRule ^data(/|$) - [F,L]

    # Roteamento amigável para PDP dinâmica, fotos limpas, checkout e página de pedido (/order ou /pedido)
    RewriteRule ^checkout/?$ checkout/index.html [L]
    RewriteRule ^products(?:/([a-zA-Z0-9_.-]+))?/?$ products/index.php?p=$1 [L,QSA]
    RewriteRule ^foto(?:/([a-zA-Z0-9_.-]+))?/?$ foto/index.php?p=$1 [L,QSA]
    RewriteRule ^pedido(?:/([a-zA-Z0-9_.-]+))?/?$ pedido/index.php?code=$1 [L,QSA]
    RewriteRule ^order(?:/([a-zA-Z0-9_.-]+))?/?$ pedido/index.php?code=$1 [L,QSA]

    # Fallback automático para fotos de produtos: se o arquivo não existir fisicamente na Hostinger,
    # busca na VPS e salva localmente servindo direto com 200 OK (nunca expõe ou redireciona para sslip.io)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^assets/images/products/([a-zA-Z0-9_.-]+\.(?:webp|png|jpe?g|avif))$ assets/images/products/proxy.php?img=$1 [L,QSA]
</IfModule>

# Fallback para quem não tiver mod_rewrite: nega por caminho de diretório.
<IfModule !mod_rewrite.c>
    <FilesMatch "\.(json|lock)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Garante que a API de produtos responda (o .htaccess de raiz pode ser lido
# depois de um 401 gerado pelo próprio script).
<Files "api/products.php">
    <IfModule mod_security.c>
        SecRuleEngine Off
    </IfModule>
</Files>

# Ensure upload.php is accessible
<Files "upload.php">
    Order allow,deny
    Allow from all
    <IfModule mod_security.c>
        SecRuleEngine Off
    </IfModule>
</Files>

# SPA fallback (if needed)
# FallbackResource /index.html