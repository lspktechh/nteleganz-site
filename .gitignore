# ==========================================
# NT Eleganz - Regras de Proteção de Deploy
# ==========================================

# Catálogo dinâmico e imagens de produtos em produção
# (Esses arquivos vivem no servidor Hostinger e NUNCA devem ser sobrescritos pelo Git)
data/products.json
data/backups/

# Segredos e estado gerado no servidor (o repositório é público)
data/vps_secret.txt
data/vip_login_attempts.json
data/.orders_vps_sync_at

# Arquivos de sistema operacional e metadados
.DS_Store
Thumbs.db
*:Zone.Identifier*
*.Zone.Identifier

# Arquivos de backup e pacotes locais
*.zip
*.tar.gz
*.rar

# Editores
.vscode/
.idea/
*.swp
*.swo

# Configurações de rastreamento definidas pelo admin em produção
# (pixels/IDs vivem no servidor Hostinger via api/tracking.php e o Git
#  NUNCA deve sobrescrevê-los num deploy)
data/tracking_settings.json

# Feedbacks gerenciados no admin e persistidos no PostgreSQL da VPS
# (Garante que deploys do Git nunca sobrescrevam os depoimentos adicionados pelo dono)
data/feedbacks.backup.json

# Dados cadastrados pelo gestor no painel (feedbacks, categorias, fretes) vivem em arquivos *.live.json
# no servidor. Os data/*.json versionados sao apenas a semente inicial: um deploy pode troca-los sem
# apagar nem reverter nada do que o gestor cadastrou.
data/*.live.json
data/.sync_images_stamp
data/.img_missing.json

# Segredos e dados pessoais gravados pelo servidor (credenciais do Mercado Pago, pedidos com nome/telefone/
# e-mail/endereco, checkouts abandonados, sessoes do admin, logs de webhook). Nunca versionar.
# ATENCAO: ignorar aqui nao remove do git o que ja foi commitado (ver docs do PR sobre git rm --cached).
data/mercadopago_settings.json
data/orders.json
data/abandoned_checkouts.json
data/admin_sessions.json
data/logs/
